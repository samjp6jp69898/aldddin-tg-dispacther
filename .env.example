# telegram-dispatcher 環境變數範本——只有 KEY，沒有值，可進 git。
# 用法：cp .env.example .env，填入真實值後 chmod 600（那份 .env 不可進 git）。
# 頭四個 CLUSTER_* 只有 worker 機需要填；head 機（跑 server.ts 的那台）不需要。

# webhook server（run-server.sh）、cron/bug-report-send.ts、worker-agent 共用的 bot token
TG_DISPATCH_BOT_TOKEN=

# webhook server 用
TG_WEBHOOK_PATH=
TG_WEBHOOK_SECRET=

# /kit 指令授權（見 lib/webhook-server/kit-issue.ts、kit-resend.ts）；不填只是 /kit 功能關閉
TG_KIT_ADMIN_CHAT_ID=

# /bugreport 指令授權與 cron/bug-report-send.ts 推播對象；不填只是 /bugreport 功能關閉
TG_BUG_REPORT_ADMIN_CHAT_ID=

# 多機派工（lib/cluster/）：head/worker 共用認證 secret（≥32 字元，兩端必須同值）
CLUSTER_SHARED_SECRET=

# 本機在 cluster 裡的身分（worker 機專用；head 機不需要下面四個）
CLUSTER_WORKER_NAME=
CLUSTER_WORKER_URL=
CLUSTER_WORKER_PORT=
CLUSTER_HEAD_URL=

# pipeline 監控 DB 化（2026-09-02，Phase 0）。見 deploy/monitor-db/README.md。
# 開關：未設定／空字串／'0' 一律視同關閉，新程式碼完全不會載入 mysql2。
MON_DB_ENABLED=
# 監控 DB（mon-mysql container，127.0.0.1:3307，與 dev 用的 db-mysql/3306 完全隔離）
MON_DB_HOST=
MON_DB_PORT=
MON_DB_SCHEMA=
# head 上的 server.ts 用 mon_head 帳號連線
MON_DB_USER=
MON_DB_PASSWORD=
# 只給 deploy/monitor-db/migrate.sh 用（DDL / 建帳號），不進其他用途
MON_DB_ROOT_PASSWORD=
# 應用層欄位加密（AES-256-GCM）：只放 head，絕不 scp 到任何 worker
MON_FIELD_KEY_V1=
MON_FIELD_KEY_ACTIVE=
# 盲索引獨立金鑰（HKDF 子金鑰的來源），不得與 MON_FIELD_KEY_* 共用
MON_BIDX_KEY=
# VictoriaLogs（127.0.0.1:9428，Basic Auth）
MON_VL_URL=
MON_VL_USER=
MON_VL_PASSWORD=
